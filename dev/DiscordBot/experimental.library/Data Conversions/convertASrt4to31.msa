# If you used AntiSpam before a format change on commit on 4/1/2025:
# this Converts deprecated reason code 4 (dupe same message across 3 channels) to new format (3 sub code 1)
admin:/updatedbas [$] = >>>
@servers = import('DiscordBot.Servers')
	# array_set(@asmembers, @discord['userid'], array('rt': @reasonCode, 'log': false, 'rtime': @time, 'time': @time, 'username': @discord['username'], 'notes': '', 'triggercount': 0))
# if(@reasonSubCode > 0) { array_set(@asmembers[@discord['userid']], 'rts', @reasonSubCode) }
foreach(@svrID in @servers) {
	@msg = @svrID.': fixed: '
	@fc = 0
	@asmembers = import('DiscordBot.'.@svrID.'.antispam.members');
	if(!is_array(@asmembers)) { 
		@asmembers = get_value('DiscordBot.'.@svrID.'.antispam.members');
	}
	if(!is_array(@asmembers)) { 
		msg('No Antispam data for server: '.@svrID)
		continue()
	}
	foreach(@userID: @userData in @asmembers) {
		if(@userID == 'lastedit') { continue() }
		if(@userData['rt'] == 4) {
			@asmembers[@userID]['rt'] = 3;
			array_set(@asmembers[@userID], 'rts', 1);
			@fc++
		}
	}
	msg(@msg.@fc)
	@asmembers['lastedit'] = time()
	export('DiscordBot.'.@svrID.'.antispam.members', @asmembers)
}
<<<